# Copy to .env. Secret values are intentionally empty.
# Required: set POSTGRES_PASSWORD to a unique password before starting Compose.
POSTGRES_PASSWORD=
# Optional: defaults are forcare / forcare, and backend host port 3001.
POSTGRES_DB=
POSTGRES_USER=
BACKEND_PORT=
# AI is disabled by default. Enable only to run the explicit non-medical smoke CLI.
AI_ENABLED=
AI_API_KEY=
AI_MODEL=
# Optional OpenAI-compatible HTTPS endpoint; blank uses the OpenAI endpoint.
AI_BASE_URL=
AI_TIMEOUT_MS=
# Required for the API: exact comma-separated origins (HTTPS in production).
AUTH_ALLOWED_ORIGINS=
# Required: at least 32 random characters for session IP hashing and cursor signing.
AUTH_SESSION_SECRET=
# Optional exact nurse email domain; this deployment approves nurse.invalid.
AUTH_NURSE_EMAIL_DOMAIN=
# Local HTTP testing only; leave blank or false in every normal deployment.
AUTH_LOCAL_HTTP_TEST=
